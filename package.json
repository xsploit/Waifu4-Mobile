{
  "name": "webwaifu-rebuild",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Clean rebuild of the WebWaifu main brain. Core loop first: input -> LLM -> text -> TTS -> mouth -> avatar.",
  "scripts": {
    "dev": "concurrently -n web,server -c cyan,magenta \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "server": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "bench:tts": "tsx scripts/bench-tts.ts",
    "typecheck": "tsc --noEmit --pretty",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^3.0.121",
    "@inworld/tts": "^1.1.1",
    "@ladybugdb/core": "^0.16.1",
    "@openrouter/ai-sdk-provider": "^2.9.0",
    "@pixiv/three-vrm": "^3.5.3",
    "@pixiv/three-vrm-animation": "^3.5.3",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@types/three": "^0.170.0",
    "ai": "^6.0.193",
    "express": "^4.21.2",
    "fish-audio": "^0.1.0",
    "phonemize": "^1.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "wlipsync": "^1.3.0",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^3.0.2"
  }
}

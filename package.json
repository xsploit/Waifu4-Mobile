{
  "name": "webwaifu-rebuild",
  "private": true,
  "version": "1.0.2",
  "author": "xsploit",
  "type": "module",
  "main": "electron/main.mjs",
  "description": "Local-first VRM companion and stream co-host with live LLM, TTS, memory, Twitch, and Discord voice surfaces.",
  "scripts": {
    "dev": "concurrently -n web,server -c cyan,magenta \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "desktop:clean": "node scripts/clean-desktop-release.mjs",
    "desktop:dev": "concurrently -k -n web,server,electron -c cyan,magenta,yellow \"npm:dev:web\" \"npm:dev:server\" \"wait-on http://127.0.0.1:5173/ http://127.0.0.1:8797/health && cross-env ELECTRON_DEV_SERVER_URL=http://127.0.0.1:5173 ELECTRON_BACKEND_EXTERNAL=true ELECTRON_BOT_PORT=8797 electron electron/main.mjs\"",
    "desktop:dist": "npm run build && npm run desktop:runtime && npm run desktop:clean && electron-builder",
    "desktop:pack": "npm run build && npm run desktop:runtime && npm run desktop:clean && electron-builder --dir",
    "desktop:runtime": "node scripts/prepare-desktop-runtime.mjs",
    "desktop:start": "npm run build && cross-env ELECTRON_BOT_PORT=8797 electron electron/main.mjs",
    "desktop:test:transparent": "electron electron/transparent-test.mjs",
    "desktop:test:transparent:bare": "electron electron/transparent-test.mjs --bare",
    "desktop:test:transparent:software": "cross-env ELECTRON_TRANSPARENT_SOFTWARE=true electron electron/transparent-test.mjs",
    "server": "tsx server/index.ts",
    "start": "node server/dist/index.js",
    "build": "npm run typecheck && npm run build:server && vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=server/dist/index.js --packages=external",
    "bench:tts": "tsx scripts/bench-tts.ts",
    "bench:vercel-json": "tsx scripts/bench-vercel-json.ts",
    "memory:recover-fallback": "tsx scripts/recover-ladybug-fallback.ts",
    "audit:dead-code": "fallow dead-code --fail-on-issues",
    "audit:dist": "tsx scripts/dist-audit.ts",
    "audit:release": "tsx scripts/release-audit.ts && npm run audit:dead-code && npm run typecheck && npm test -- --run && npm run build && npm run audit:dist && npm run smoke:runtime",
    "smoke:desktop-owned-backend-reuse": "node scripts/smoke-desktop-owned-backend-reuse.mjs",
    "smoke:desktop-port-fallback": "node scripts/smoke-desktop-port-fallback.mjs",
    "smoke:desktop-relaunch": "node scripts/smoke-desktop-relaunch.mjs",
    "smoke:packaged-ui": "node scripts/smoke-packaged-ui.mjs",
    "smoke:packaged-ui:desktop": "node scripts/smoke-packaged-ui.mjs --window-mode=desktop --exercise-desktop-controls",
    "smoke:runtime": "tsx scripts/smoke-runtime.ts",
    "typecheck": "tsc --noEmit --pretty",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.16",
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "@huggingface/transformers": "^4.2.0",
    "@inworld/tts": "^1.1.1",
    "@ladybugdb/core": "^0.16.1",
    "@mintplex-labs/piper-tts-web": "^1.0.4",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@pixiv/three-vrm": "^3.5.3",
    "@pixiv/three-vrm-animation": "^3.5.3",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@types/three": "^0.170.0",
    "ai": "^7.0.22",
    "better-sqlite3": "^12.10.0",
    "discord.js": "^14.26.5",
    "express": "^4.21.2",
    "fish-audio": "^0.1.0",
    "lil-gui": "^0.21.0",
    "phonemize": "^1.2.0",
    "phonemizer": "^1.2.1",
    "pomljs": "file:vendor/pomljs-0.0.9.tgz",
    "prism-media": "^1.3.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "wlipsync": "^1.3.0",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "fallow": "^2.88.3",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vite": "^6.0.7",
    "vitest": "^3.0.2",
    "wait-on": "^9.0.10"
  },
  "overrides": {
    "@discordjs/rest": {
      "undici": "6.27.0"
    },
    "discord.js": {
      "undici": "6.27.0"
    }
  },
  "build": {
    "appId": "ai.webwaifu.webwaifu4",
    "productName": "WebWaifu 4",
    "afterPack": "scripts/after-pack.mjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "server/dist/**",
      "src/lib/chat/templates/**",
      "vendor/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "desktop-runtime",
        "to": "desktop-runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/**",
      "server/dist/**",
      "src/lib/chat/templates/**"
    ],
    "npmRebuild": false,
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "WebWaifu-4-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "WebWaifu-4-Portable-${version}-${arch}.${ext}"
    }
  }
}

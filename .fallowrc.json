    "electron/preload.mjs",
    "scripts/after-pack.mjs",
    "scripts/after-sign.mjs"
  ],
  "ignoreDependencies": [
    "better-sqlite3",
    "@discordjs/opus",
    "lil-gui",
    "wait-on"
